{
  "name": "solidity-gas-lens",
  "displayName": "Solidity Gas Lens",
  "description": "Live gas-cost inlay hints for Solidity functions, measured against a local Anvil node.",
  "publisher": "dallalanaluca",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/luca-dallalana/SolidityGasLens"
  },
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Solidity Gas Lens",
      "properties": {
        "gasLens.enabled": {
          "type": "boolean",
          "default": true
        },
        "gasLens.anvilPort": {
          "type": "number",
          "default": 8545
        },
        "gasLens.foundryMode": {
          "type": "boolean",
          "default": true,
          "description": "Extract real argument values from a matching Foundry *.t.sol test file instead of zero-value placeholders, where possible."
        },
        "gasLens.gasIncreaseThreshold": {
          "type": "number",
          "default": 5,
          "description": "Percent gas increase required to show the increase glyph on a hint."
        },
        "gasLens.gasDecreaseThreshold": {
          "type": "number",
          "default": 5,
          "description": "Percent gas decrease required to show the decrease glyph on a hint."
        },
        "gasLens.showOnlyPublic": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=dist/extension.js && echo '{\"type\":\"commonjs\"}' > dist/package.json",
    "build": "npm run compile",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile:package": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --minify --outfile=dist/extension.js && echo '{\"type\":\"commonjs\"}' > dist/package.json",
    "vscode:prepublish": "npm run typecheck && npm run compile:package",
    "test": "vitest run"
  },
  "dependencies": {
    "@solidity-parser/parser": "^0.19.0",
    "ethers": "^6.13.4",
    "solc": "^0.8.28"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
